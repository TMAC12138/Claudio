# Claude CLI path (default: claude in PATH)
CLAUDE_PATH=claude

# NeteaseCloudMusic API (locally deployed)
NCM_BASE_URL=http://localhost:3001
NCM_LEVEL=standard

# Xiaomi MiMo V2.5 TTS
MIMO_API_KEY=
