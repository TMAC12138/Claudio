MIMO_TTS_STYLE=温暖自然的中文私人电台女声，语速适中，表达松弛而有陪伴感。

# OpenWeather
WEATHER_API_KEY=
WEATHER_CITY=Beijing

# Feishu/Lark (M2)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
